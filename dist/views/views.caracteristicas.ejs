<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('partials/head', { title: 'Gestión de Características', css: ['/css/crear.bodega.css'], fuentes: true }) %>
</head>

  <body>
    <div class="admin-container">
      <!-- Sidebar Navigation -->
      <aside class="sidebar">
        <div class="logo-container">
          <img src="/img/Trost_blanco.png" alt="Logo" class="logo" />
        </div>

        <nav class="sidebar-nav">
          <div class="nav-section">
            <h3 class="nav-section-title">USUARIOS</h3>
            <select class="nav-select" id="adminUsuario">
              <option value="">Admin-usuario</option>
              <option value="/usuario">Crear usuarios</option>
            </select>
          </div>

          <div class="nav-section">
            <h3 class="nav-section-title">BODEGAS</h3>
            <select class="nav-select" id="bodegas">
              <option value="">Bodegas</option>
              <option value="/crear_bodega">Crear Bodegas</option>
              <option value="/seguimiento">Seguimiento Bodega</option>
              <option value="/inventario">Inventario de Bodegas</option>
              <option value="/catalogo">Catálogo de productos</option>
            </select>
          </div>

          <div class="nav-section">
            <h3 class="nav-section-title">PRODUCTOS</h3>
            <select class="nav-select" id="productos">
              <option value="">Opción</option>
              <option value="/caracteristicas">Características</option>
            </select>
          </div>

          <div class="nav-section">
            <h3 class="nav-section-title">HISTORIAL</h3>
            <select class="nav-select" id="historial">
              <option value="">Historial</option>
              <option value="/historial">Lista de Historial</option>
              <option value="/logistica">Producto en Logistica</option>
              <option value="/consumo-terminada-completo">Consumo a Terminada Completo</option>
            </select>
          </div>
        </nav>

        <div class="user-profile">
          <div class="user-avatar">
            <i class="fas fa-user-circle"></i>
          </div>
          <div class="user-info">
            <span class="user-name" id="currentUserName">Nombre Usuario</span>
            <span class="user-role" id="currentUserRole">Rol</span>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="main-content">
        <header class="content-header">
          <h1><i class="fas fa-cogs"></i> Gestión de Características</h1>
          <div class="header-actions">
            <button class="notification-btn" onclick="irAVistaAlertas()">
              <i class="fas fa-bell"></i>
              <span class="notification-badge">1</span>
            </button>
          </div>
        </header>

        <div class="content-grid">
          <!-- Form Section -->
          <section class="form-section card">
            <h2 class="section-title">
              <i class="fas fa-plus-circle"></i> Crear Nueva Característica
            </h2>

            <form id="caracteristicaForm" class="caracteristica-form">
              <div class="form-group">
                <label for="valorCaracteristica">Valor de Característica</label>
                <input
                  type="text"
                  id="valorCaracteristica"
                  placeholder="Ej: 30P, 110P, 230P"
                  maxlength="10"
                  required
                />
                <small style="color: var(--text-tertiary); font-size: 0.8rem;">
                  Ejemplos: 30P, 40P, 110P, 230P
                </small>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn-primary">
                  <i class="fas fa-save"></i> Guardar Característica
                </button>
              </div>
            </form>
          </section>

          <!-- Caracteristicas Table Section -->
          <section class="table-section card">
            <div class="table-header">
              <h2 class="section-title">
                <i class="fas fa-list"></i> Listado de Características
              </h2>
              <div class="table-controls">
                <div class="search-box">
                  <i class="fas fa-search"></i>
                  <input
                    type="text"
                    placeholder="Buscar característica..."
                    id="caracteristicaSearch"
                  />
                </div>
              </div>
            </div>

            <div class="table-responsive">
              <table class="bodegas-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Valor</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="caracteristicasTableBody">
                  <!-- Las filas se insertarán aquí dinámicamente -->
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </main>
    </div>

    <!-- Modal para editar -->
    <div id="modalEditar" class="modal" style="display: none;">
      <div class="modal-content">
        <span class="modal-close" onclick="cerrarModal()">&times;</span>
        <h2><i class="fas fa-edit"></i> Editar Característica</h2>
        <div class="form-group" style="margin-top: 1.5rem;">
          <label for="editarValor">Valor</label>
          <input type="text" id="editarValor" maxlength="10" />
        </div>
        <div class="form-group" style="margin-top: 1rem;">
          <label for="editarEstado">Estado</label>
          <select id="editarEstado">
            <option value="ACTIVA">Activa</option>
            <option value="INACTIVA">Inactiva</option>
          </select>
        </div>
        <div class="form-actions" style="margin-top: 1.5rem;">
          <button class="btn-primary" onclick="guardarEdicion()">
            <i class="fas fa-save"></i> Guardar Cambios
          </button>
          <button class="btn-secondary" style="margin-left: 0.5rem;" onclick="cerrarModal()">
            <i class="fas fa-times"></i> Cancelar
          </button>
        </div>
      </div>
    </div>

    <script src="/js/crear.caracteristicas.js"></script>
  </body>
</html>