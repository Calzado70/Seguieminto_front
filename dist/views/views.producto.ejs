<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { title: 'Supervisor - Movimientos', css: ['/css/producto.css'] }) %>
</head>

<body>
    <div class="container">
        <!-- Navbar -->
        <nav class="navbar">
            <div class="navbar-left">
                <a class="navbar-brand" href="/supervisor" aria-label="Trost">
                    <img src="/img/Trost_blanco.png" alt="Logo Trost" class="logo">
                </a>

                <div class="dropdown">
                    <button class="dropdown-toggle" type="button">
                        <i class="fas fa-chart-bar"></i>
                        <span>Consultas</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="dropdown-menu">
                        <a href="/inventario_supervisor"><i class="fas fa-boxes"></i> Inventario</a>
                        <a href="#"><i class="fas fa-chart-pie"></i> Stock por Producto</a>
                        <a href="#"><i class="fas fa-history"></i> Historial</a>
                    </div>
                </div>
            </div>

            <div class="navbar-options">
                <button class="nav-btn accent" id="transferencia" value="/supervisor">
                    <i class="fas fa-exchange-alt"></i>
                    <span>Transferencias</span>
                </button>

                <div class="user-info">
                    <i class="fas fa-user-circle"></i>
                    <span id="current-user"></span>
                </div>
            </div>
        </nav>

        <!-- Modales -->
        <div class="modal-overlay" id="modalMovimiento" style="display: none">
            <div class="modal-card">
                <div class="modal-header">
                    <h3><i class="fas fa-truck-moving"></i> Confirmar Movimiento</h3>
                    <button class="modal-close">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <i class="fas fa-box"></i>
                            <div>
                                <label>Producto</label>
                                <p id="productoMovimiento">-</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-arrow-up"></i>
                            <div>
                                <label>Bodega Origen</label>
                                <p id="bodegaOrigen">-</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-arrow-down"></i>
                            <div>
                                <label>Bodega Destino</label>
                                <p id="bodegaDestinoSpan">-</p>
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-exchange-alt"></i>
                            <div>
                                <label>Tipo de Movimiento</label>
                                <p id="tipoMovimiento">-</p>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="observaciones"><i class="fas fa-sticky-note"></i> Observaciones</label>
                        <textarea id="observaciones" class="form-textarea"
                            placeholder="Agregue observaciones sobre este movimiento (opcional)" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" id="cancelarMovimiento">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button class="btn btn-primary" id="confirmarMovimiento">
                        <i class="fas fa-check"></i> Confirmar Movimiento
                    </button>
                </div>
            </div>
        </div>

        <div class="modal-overlay" id="modalErrorStock" style="display: none">
            <div class="modal-card error">
                <div class="modal-header error">
                    <h3><i class="fas fa-exclamation-triangle"></i> <span id="tituloModalErrorStock">Error de Stock</span></h3>
                </div>
                <div class="modal-body">
                    <div class="error-icon">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <p id="mensajeErrorStock" class="error-message">No hay suficiente stock disponible.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" id="cerrarModalErrorStock">
                        <i class="fas fa-check"></i> Entendido
                    </button>
                </div>
            </div>
        </div>

        <!-- Contenido Principal -->
        <main class="main-content">
            <!-- Encabezado con estadísticas -->
            <header class="content-header">
                <div class="header-left">
                    <i class="fas fa-warehouse header-icon" aria-hidden="true"></i>
                    <div class="header-text">
                        <h1>Gestión de Movimientos</h1>
                        <p class="subtitle">Realiza transferencias, consumos y movimientos entre bodegas</p>
                    </div>
                </div>

                <div class="header-stats">
                    <div class="stat-card stat-products">
                        <i class="fas fa-box-open"></i>
                        <div>
                            <span class="stat-value" id="totalProductos">0</span>
                            <span class="stat-label">Productos</span>
                        </div>
                    </div>

                    <div class="stat-card stat-date">
                        <i class="fas fa-calendar-day"></i>
                        <div>
                            <span class="stat-value" id="currentDate">-</span>
                            <span class="stat-label">Fecha Actual</span>
                        </div>
                    </div>

                    <div class="stat-card stat-timer"
                        title="Transferencia automática cada 2 horas con los productos de la lista.">
                        <i class="fas fa-clock"></i>
                        <div>
                            <span class="stat-value" id="autoTransferCountdown">02:00:00</span>
                            <span class="stat-label">Próxima transferencia</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Panel de Control -->
            <div class="control-panel">
                <!-- Configuración -->
                <section class="panel-section config-panel">
                    <h3>
                        <i class="fas fa-sliders-h" aria-hidden="true"></i>
                        <span>Configuración del Movimiento</span>
                    </h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="usuario"><i class="fas fa-user"></i> Usuario</label>
                            <div class="input-with-icon">
                                <i class="fas fa-user-tag"></i>
                                <input type="text" class="form-control" id="usuario" placeholder="Usuario" disabled />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="bodegaActual"><i class="fas fa-warehouse"></i> Bodega </label>
                            <div class="input-with-icon">
                                <i class="fas fa-location-arrow"></i>
                                <input type="text" class="form-control" id="bodegaActual" placeholder="Bodega Actual"
                                    disabled />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="codigo_producto"><i class="fas fa-barcode"></i> Código del Producto</label>
                            <div class="input-with-icon">
                                <i class="fas fa-qrcode"></i>
                                <input type="text" class="form-control" id="codigo_producto"
                                    placeholder="Escanee o ingrese el código" />
                                <button class="input-action" id="scanBtn" type="button" title="Escanear código">
                                    <i class="fas fa-barcode"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="cantidad_manual"><i class="fas fa-balance-scale"></i> Cantidad</label>
                            <div class="input-with-icon">
                                <i class="fas fa-boxes"></i>
                                <input type="number" class="form-control" id="cantidad_manual"
                                    placeholder="Cantidad (opcional)" min="0.5" step="0.5" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="id_bodega"><i class="fas fa-map-marker-alt"></i> Bodega Destino o Consumo</label>
                            <div class="select-with-icon">
                                <i class="fas fa-arrow-right"></i>
                                <select id="id_bodega" required class="form-control">
                                    <option value="">Seleccione bodega destino</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="tipoMovimientoSelect"><i class="fas fa-exchange-alt"></i> Tipo de
                                Movimiento</label>
                            <div class="select-with-icon">
                                <i class="fas fa-directions"></i>
                                <select class="form-control" id="tipoMovimientoSelect">
                                    <option value="">Seleccione tipo</option>
                                    <option value="ENTRADA" class="entrada">ENTRADA</option>
                                    <option value="PROCESO" class="Proceso">PROCESO</option>
                                    <option value="COMPLETO" class="Completo">COMPLETO</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group full-width" id="caracteristicas-container">
                            <label for="caracteristicas">
                                <i class="fas fa-cogs"></i> Características
                            </label>
                            <div class="input-with-icon">
                                <i class="fas fa-keyboard"></i>
                                <input type="text" class="form-control" id="caracteristicas"
                                    placeholder="Ingrese características del producto" />
                            </div>
                            <small id="caracteristicas-help" class="help-text" style="display: none;">
                                <i class="fas fa-info-circle"></i> Solo disponible en bodega Terminada
                            </small>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-success btn-transfer" id="mover-productos" type="button">
                                <i class="fas fa-paper-plane"></i>
                                <span>Realizar Transferencia</span>
                            </button>

                            <div class="form-actions-row">
                                <button class="btn btn-danger" id="limpiar-lista" type="button">
                                    <i class="fas fa-trash-alt"></i>
                                    <span>Limpiar Lista</span>
                                </button>
                                <button class="btn btn-info" id="agregar-manual" type="button">
                                    <i class="fas fa-plus-circle"></i>
                                    <span>Agregar Manual</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Productos Agregados -->
                <section class="panel-section products-panel">
                    <div class="section-header">
                        <h3>
                            <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                            <span>Productos en Lista</span>
                        </h3>
                        <div class="section-actions">
                            <span class="badge" id="totalItems">0 items</span>
                            <span class="badge badge-primary" id="totalQuantity">0 unidades</span>
                        </div>
                    </div>

                    <div class="table-container">
                        <div class="table-responsive">
                            <table class="modern-table" id="tablaProductos">
                                <thead>
                                    <tr>
                                        <th class="col-user" title="Usuario"><i class="fas fa-user"></i></th>
                                        <th><i class="fas fa-arrow-up"></i> Origen</th>
                                        <th><i class="fas fa-arrow-down"></i> Destino</th>
                                        <th><i class="fas fa-boxes"></i> Cantidad</th>
                                        <th><i class="fas fa-barcode"></i> Código</th>
                                        <th><i class="fas fa-ruler"></i> Talla</th>
                                        <th><i class="fas fa-exchange-alt"></i> Tipo</th>
                                        <th><i class="fas fa-cogs"></i> Características</th>
                                        <th><i class="fas fa-calendar"></i> Fecha</th>
                                        <th><i class="fas fa-cog"></i> Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Filas se agregan dinámicamente -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Estado vacío -->
                        <div class="empty-state" id="emptyState">
                            <i class="fas fa-clipboard-list"></i>
                            <h4>No hay productos en la lista</h4>
                            <p>Agrega productos escaneando códigos o ingresándolos manualmente</p>
                        </div>
                    </div>
                </section>
            </div>
        </main>

        <!-- Footer (oculto en el diseño, conserva los ids usados por el JS) -->
        <footer class="app-footer" aria-hidden="true">
            <div class="footer-content">
                <div class="footer-logo">
                    <img src="/img/Trost_blanco.png" alt="Logo" class="footer-logo-img">
                </div>
                <div class="footer-info">
                    <p><i class="fas fa-copyright"></i> 2024 Sistema de Gestión de Bodegas</p>
                    <p><i class="fas fa-user"></i> Usuario: <span id="footer-user">-</span></p>
                    <p><i class="fas fa-warehouse"></i> Bodega: <span id="footer-bodega">-</span></p>
                </div>
                <div class="footer-status">
                    <div class="status-indicator active">
                        <span class="status-dot"></span>
                        <span>Sistema Online</span>
                    </div>
                    <div class="last-update">
                        <i class="fas fa-sync-alt"></i>
                        <span>Última actualización: <span id="lastUpdate">-</span></span>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="/js/producto.js"></script>
</body>

</html>
