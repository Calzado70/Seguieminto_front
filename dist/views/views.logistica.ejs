<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Consumo a Logística', css: ['/css/logistica.css'] }) %>
</head>
<body>
    <div class="container">
        <!-- Navbar -->
        <nav class="navbar">
            <img src="/img/Trost_blanco.png" alt="Logo" class="logo">
            <div class="navbar-options">
                <button type="button" class="export nav-inventario" id="verInventario">Ver Inventario</button>
            </div>
        </nav>

        <!-- Contenido principal -->
        <div class="content-segundario">
            <div class="cont-segun-formu">
                <div class="table-header">Consumo de Terminada Completo a Logística</div>

                <!-- Búsqueda por código de barras -->
                <div class="filtros">
                    <input type="text" class="input-buscar" id="codigoBarras"
                        placeholder="Escanee o digite el código de barras" autofocus>
                    <button type="button" class="export" id="buscarProducto">Buscar</button>
                </div>

                <!-- Resultado del producto -->
                <div id="resultadoProducto" class="resultado" style="display: none;">
                    <div class="resumen-producto">
                        <div class="campo"><span class="campo-label">Referencia:</span><span id="rReferencia" class="campo-valor">-</span></div>
                        <div class="campo"><span class="campo-label">SKU:</span><span id="rSku" class="campo-valor">-</span></div>
                        <div class="campo"><span class="campo-label">Talla:</span><span id="rTalla" class="campo-valor">-</span></div>
                        <div class="campo"><span class="campo-label">Código:</span><span id="rCodigoProducto" class="campo-valor">-</span></div>
                        <div class="campo"><span class="campo-label">Stock en Terminada Completo:</span><span id="rStock" class="campo-valor">-</span></div>
                    </div>

                    <div class="filtros">
                        <input type="number" class="input-buscar" id="cantidadConsumo"
                            placeholder="Cantidad a consumir" min="1" value="1">
                        <button type="button" class="export" id="consumirBoton">Consumir a Logística</button>
                    </div>
                </div>

                <!-- Mensajes -->
                <div id="mensajes"></div>
            </div>
        </div>
    </div>
    <script src="/js/logistica.js"></script>
</body>
</html>