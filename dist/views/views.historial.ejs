<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Historial de Movimientos | Trost', css: ['/css/historial.css'] }) %>
</head>
<body>
  <div class="app-container">
    <!-- Barra de navegación mejorada -->
    <nav class="app-navbar">
      <div class="navbar-brand">
        <img src="/img/Trost_blanco.png" alt="Logo" class="logo">
        <span class="app-name">Gestión de Inventario</span>
      </div>
      
      <div class="navbar-actions">
        <div class="dropdown">
          <select class="dropdown-select" id="adminUsuario">
            <option value="" selected disabled>Admin-usuario</option>
            <option value="/usuario">Crear usuarios</option>
          </select>
          <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
        
        <div class="dropdown">
          <select class="dropdown-select" id="bodegas">
            <option value="" selected disabled>Bodegas</option>
            <option value="/crear_bodega">Crear Bodegas</option>
            <option value="/seguimiento">Seguimiento Bodega</option>
          </select>
          <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
        
        <div class="dropdown">
          <select class="dropdown-select" id="historial">
            <option value="" selected disabled>Historial</option>
            <option value="/historial">Lista de Historial</option>
            <option value="/logistica">Producto en Logística</option>
            <option value="/consumo-terminada-completo">Consumo a Terminada Completo</option>
          </select>
          <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>

        <div class="dropdown">
          <select class="dropdown-select" id="productos">
            <option value="" selected disabled>Productos</option>
            <option value="/caracteristicas">Características</option>
          </select>
          <i class="fas fa-chevron-down dropdown-icon"></i>
        </div>
      </div>
    </nav>

    <!-- Contenido principal -->
    <main class="app-content">
      <section class="history-section">
        <div class="section-header">
          <h2><i class="fas fa-history"></i> Historial</h2>
          <div class="header-tabs" role="tablist">
            <button class="header-tab is-active" id="tabMovimientos" role="tab"
                    aria-selected="true" aria-controls="panelMovimientos">
              <i class="fas fa-exchange-alt"></i> Movimientos
            </button>
            <button class="header-tab" id="tabAuditoria" role="tab"
                    aria-selected="false" aria-controls="panelAuditoria">
              <i class="fas fa-clipboard-check"></i> Auditoría
            </button>
          </div>
          <button class="export-button" id="exportarExcel">
            <i class="fas fa-file-excel"></i> Exportar a Excel
          </button>
        </div>

        <!-- Pestaña 1: movimientos de inventario -->
        <div class="tab-panel" id="panelMovimientos" role="tabpanel" aria-labelledby="tabMovimientos">
          <div class="history-container" id="historialContainer">
            <!-- Encabezados de la tabla -->
            <div class="table-header">
              <div class="header-cell">Bodega</div>
              <div class="header-cell">Código</div>
              <div class="header-cell">Característica</div>
              <div class="header-cell">Usuario</div>
              <div class="header-cell">Cant. Ant.</div>
              <div class="header-cell">Cant. Nueva</div>
              <div class="header-cell">Fecha</div>
            </div>

            <!-- Contenedor dinámico para los registros -->
            <div class="table-body" id="historialRows"></div>

            <!-- Controles de paginación se insertarán aquí -->
          </div>
        </div>

        <!-- Pestaña 2: auditoría de cambios (Fase 4.3) -->
        <div class="tab-panel" id="panelAuditoria" role="tabpanel"
             aria-labelledby="tabAuditoria" hidden>
          <div class="history-container history-container--auditoria" id="auditoriaContainer">
            <div class="audit-filters">
              <div class="audit-filter">
                <label for="auditTabla">Tabla</label>
                <select id="auditTabla">
                  <option value="">Todas</option>
                </select>
              </div>
              <div class="audit-filter">
                <label for="auditAccion">Acción</label>
                <select id="auditAccion">
                  <option value="">Todas</option>
                </select>
              </div>
              <div class="audit-filter">
                <label for="auditUsuario">Usuario</label>
                <input type="text" id="auditUsuario" placeholder="Buscar por nombre">
              </div>
              <div class="audit-filter">
                <label for="auditDesde">Desde</label>
                <input type="date" id="auditDesde">
              </div>
              <div class="audit-filter">
                <label for="auditHasta">Hasta</label>
                <input type="date" id="auditHasta">
              </div>
              <button class="audit-filter-reset" id="auditLimpiar">
                <i class="fas fa-times"></i> Limpiar
              </button>
            </div>

            <div class="table-header table-header--auditoria">
              <div class="header-cell">Fecha</div>
              <div class="header-cell">Tabla</div>
              <div class="header-cell">Acción</div>
              <div class="header-cell">Usuario</div>
              <div class="header-cell">IP</div>
              <div class="header-cell">Detalle</div>
            </div>

            <div class="table-body" id="auditoriaRows"></div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script src="/js/historial.js"></script>
  <script src="/js/auditoria.js"></script>
</body>
</html>
