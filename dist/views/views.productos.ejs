<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head', { title: 'Lista de Productos | Trost', css: ['/css/catalogo.css'] }) %>
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="navbar-logo">
            <img src="/img/Trost_blanco.png" alt="Trost">
        </div>

        <div class="sidebar-nav">
            <div class="nav-section">
                <h3 class="nav-section-title">USUARIOS</h3>
                <select class="nav-select" id="adminUsuario">
                    <option value="">Usuarios</option>
                    <option value="/usuario">Admin-usuario</option>
                </select>
            </div>

            <div class="nav-section">
                <h3 class="nav-section-title">BODEGAS</h3>
                <select class="nav-select" id="bodegas">
                    <option value="">Bodegas</option>
                    <option value="/crear_bodega">Crear Bodegas</option>
                    <option value="/seguimiento">Seguimiento Bodega</option>
                    <option value="/inventario">Inventario de Bodegas</option>
          <option value="/ajustar-inventario">Ajuste de Inventario</option>
                    <option value="/catalogo">Catálogo de productos</option>
                </select>
            </div>

            <div class="nav-section">
                <h3 class="nav-section-title">PRODUCTOS</h3>
                <select class="nav-select" id="productos">
                    <option value="">Productos</option>
                    <option value="/productos">Lista de productos</option>
                    <option value="/caracteristicas">Características</option>
                </select>
            </div>

            <div class="nav-section">
                <h3 class="nav-section-title">HISTORIAL</h3>
                <select class="nav-select" id="historial">
                    <option value="">Historial</option>
                    <option value="/historial">Lista de Historial</option>
                    <option value="/logistica">Producto en Logística</option>
                    <option value="/consumo-terminada-completo">Consumo a Terminada Completo</option>
                </select>
            </div>

            <div class="nav-section">
                <h3 class="nav-section-title">IMPORTAR</h3>
                <select class="nav-select" id="importarNav">
                    <option value="">Importar</option>
                    <option value="/importar">Carga masiva</option>
                </select>
            </div>
        </div>
    </nav>

    <div class="container">
        <header class="topbar">
            <div class="logo-container">
                <img src="/img/Trost_blanco.png" class="logo" alt="Trost Logo">
            </div>
            <div class="header-content">
                <h1>
                    <i class="fas fa-boxes"></i>
                    Lista de Productos
                </h1>
                <p class="subtitle">Productos registrados en la tabla productos</p>
            </div>
        </header>

        <section class="card">
            <div class="card-header">
                <h2>
                    <i class="fas fa-list"></i>
                    Productos
                </h2>
                <div class="stats" id="stats">
                    <span class="stat-badge">
                        <i class="fas fa-database"></i>
                        <span id="totalCount">0</span> productos
                    </span>
                </div>
            </div>

            <div class="acciones">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="buscar" placeholder="Buscar por código o característica..." class="input-search">
                    <button id="clearSearch" class="clear-search" style="display: none;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="search-container">
                    <i class="fas fa-filter search-icon"></i>
                    <select id="filtroEstado" class="input-search">
                        <option value="">Todos los estados</option>
                        <option value="ACTIVO">Activos</option>
                        <option value="INACTIVO">Inactivos</option>
                    </select>
                </div>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Característica</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody id="tablaProductos">
                        <tr class="loading-row">
                            <td colspan="5">
                                <div class="loading-spinner"></div>
                                <span>Cargando productos...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="pagination-container" id="paginationContainer">
                <div class="pagination-info">
                    Mostrando <span id="startRange">0</span> - <span id="endRange">0</span> de <span id="totalItems">0</span> productos
                </div>
                <div class="pagination-controls">
                    <button id="btnFirst" class="page-btn" onclick="irPrimeraPagina()">
                        <i class="fas fa-angle-double-left"></i>
                    </button>
                    <button id="btnPrev" class="page-btn" onclick="paginaAnterior()">
                        <i class="fas fa-angle-left"></i>
                    </button>
                    <div class="page-numbers" id="pageNumbers"></div>
                    <button id="btnNext" class="page-btn" onclick="paginaSiguiente()">
                        <i class="fas fa-angle-right"></i>
                    </button>
                    <button id="btnLast" class="page-btn" onclick="irUltimaPagina()">
                        <i class="fas fa-angle-double-right"></i>
                    </button>
                </div>
                <div class="page-size-selector">
                    <label>Mostrar:</label>
                    <select id="pageSizeSelect">
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
        </section>
    </div>

    <script src="/js/productos.js"></script>
</body>

</html>
